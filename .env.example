VITE_API_URL=http://127.0.0.1:8000/api
# Origin plus /api only. Do not append /graphql or /v1.
VITE_BASENAME=/
VITE_WEBSITE=http://localhost:3000
VITE_GITHUB=https://raw.githubusercontent.com/ebi-pf-team/genome-properties/master
VITE_GP_SERVER=https://wwwdev.ebi.ac.uk/interpro/genomeproperties/cgi-bin/test.pl
VITE_SHOW_SERVICE_DISRUPTION=false

# Content and database URLs. In Kubernetes these come from gp-frontend-configmap.
# Leave unset locally to use the defaults in src/constants/links.ts.
# VITE_URL_INTERPROSCAN=https://www.ebi.ac.uk/interpro/interproscan.html
# VITE_URL_GITHUB_REPO=https://github.com/ebi-pf-team/genome-properties
# VITE_URL_PROTEOME_LIST=https://github.com/ebi-pf-team/genome-properties/blob/master/flatfiles/proteome_list.csv
# VITE_URL_GITHUB_README=https://github.com/ebi-pf-team/genome-properties/blob/master/README.md
# VITE_URL_FLATFILE_DOCS=https://genome-properties.readthedocs.io/en/latest/flatfile.html
# VITE_URL_READTHEDOCS=https://genome-properties.readthedocs.io/en/latest/index.html
# VITE_URL_TRAINING_QUICK_TOUR=https://www.ebi.ac.uk/training/online/course/genome-properties-quick-tour
# VITE_URL_TRAINING_TUTORIAL=https://www.ebi.ac.uk/training/online/course/genome-properties-tutorial
# VITE_URL_KEGG=https://www.genome.jp/dbget-bin/www_bget?pathway:{link}
# VITE_URL_IUBMB=https://www.chem.qmul.ac.uk/iubmb/enzyme/reaction/{link}/{others}.html
# VITE_URL_METACYC=https://metacyc.org/META/NEW-IMAGE?type=NIL&object={link}
# VITE_URL_COMPLEX_PORTAL=https://www.ebi.ac.uk/complexportal/complex/{link}
# VITE_URL_PDBE=https://www.ebi.ac.uk/pdbe/entry/pdb/{link}
# VITE_URL_QUICKGO=https://www.ebi.ac.uk/QuickGO/GTerm?id={id}
# VITE_URL_INTERPRO_ENTRY=https://www.ebi.ac.uk/interpro/entry/{id}
# VITE_URL_TIGRFAM=https://www.jcvi.org/cgi-bin/tigrfams/HmmReportPage.cgi?acc={id}
# VITE_URL_EUROPEPMC=https://europepmc.org/abstract/MED/{pmid}
# VITE_URL_STATUS_PAGE=https://genomes-properties.cronitorstatus.com/
# VITE_URL_PAPER_NAR=https://doi.org/10.1093/nar/gky1013
# VITE_URL_PUBMED_NAR=https://pubmed.ncbi.nlm.nih.gov/30364992/
# VITE_URL_PAPER_BIOINFORMATICS=https://doi.org/10.1093/bioinformatics/bti015
# VITE_URL_PAPER_NAR_2013=https://doi.org/10.1093/nar/gks1234
# VITE_URL_EMBL=https://www.embl.org
# VITE_URL_BBSRC=https://www.ukri.org/councils/bbsrc/
# VITE_URL_NSF=https://www.nsf.gov
# VITE_CONTACT_EMAIL=mailto:GenProp@ebi.ac.uk
