FROM node:22-alpine AS build

WORKDIR /app

ARG VITE_BASENAME=/
ENV VITE_BASENAME=$VITE_BASENAME
ENV NODE_OPTIONS="--max-old-space-size=4096"

COPY package.json package-lock.json* /app/
RUN npm ci --legacy-peer-deps

COPY . /app
# Vite inlines env at build time. Placeholders are replaced from the ConfigMap
# at container start by docker-entrypoint.sh.
RUN VITE_API_URL="VITE_API_URL_PLACEHOLDER" \
    VITE_WEBSITE="VITE_WEBSITE_PLACEHOLDER" \
    VITE_GITHUB="VITE_GITHUB_PLACEHOLDER" \
    VITE_GP_SERVER="VITE_GP_SERVER_PLACEHOLDER" \
    VITE_SHOW_SERVICE_DISRUPTION="VITE_SHOW_SERVICE_DISRUPTION_PLACEHOLDER" \
    VITE_URL_INTERPROSCAN="VITE_URL_INTERPROSCAN_PLACEHOLDER" \
    VITE_URL_GITHUB_REPO="VITE_URL_GITHUB_REPO_PLACEHOLDER" \
    VITE_URL_PROTEOME_LIST="VITE_URL_PROTEOME_LIST_PLACEHOLDER" \
    VITE_URL_GITHUB_README="VITE_URL_GITHUB_README_PLACEHOLDER" \
    VITE_URL_FLATFILE_DOCS="VITE_URL_FLATFILE_DOCS_PLACEHOLDER" \
    VITE_URL_READTHEDOCS="VITE_URL_READTHEDOCS_PLACEHOLDER" \
    VITE_URL_TRAINING_QUICK_TOUR="VITE_URL_TRAINING_QUICK_TOUR_PLACEHOLDER" \
    VITE_URL_TRAINING_TUTORIAL="VITE_URL_TRAINING_TUTORIAL_PLACEHOLDER" \
    VITE_URL_KEGG="VITE_URL_KEGG_PLACEHOLDER" \
    VITE_URL_IUBMB="VITE_URL_IUBMB_PLACEHOLDER" \
    VITE_URL_METACYC="VITE_URL_METACYC_PLACEHOLDER" \
    VITE_URL_COMPLEX_PORTAL="VITE_URL_COMPLEX_PORTAL_PLACEHOLDER" \
    VITE_URL_PDBE="VITE_URL_PDBE_PLACEHOLDER" \
    VITE_URL_QUICKGO="VITE_URL_QUICKGO_PLACEHOLDER" \
    VITE_URL_INTERPRO_ENTRY="VITE_URL_INTERPRO_ENTRY_PLACEHOLDER" \
    VITE_URL_TIGRFAM="VITE_URL_TIGRFAM_PLACEHOLDER" \
    VITE_URL_EUROPEPMC="VITE_URL_EUROPEPMC_PLACEHOLDER" \
    VITE_URL_STATUS_PAGE="VITE_URL_STATUS_PAGE_PLACEHOLDER" \
    VITE_URL_PAPER_NAR="VITE_URL_PAPER_NAR_PLACEHOLDER" \
    VITE_URL_PUBMED_NAR="VITE_URL_PUBMED_NAR_PLACEHOLDER" \
    VITE_URL_PAPER_BIOINFORMATICS="VITE_URL_PAPER_BIOINFORMATICS_PLACEHOLDER" \
    VITE_URL_PAPER_NAR_2013="VITE_URL_PAPER_NAR_2013_PLACEHOLDER" \
    VITE_URL_EMBL="VITE_URL_EMBL_PLACEHOLDER" \
    VITE_URL_BBSRC="VITE_URL_BBSRC_PLACEHOLDER" \
    VITE_URL_NSF="VITE_URL_NSF_PLACEHOLDER" \
    VITE_CONTACT_EMAIL="VITE_CONTACT_EMAIL_PLACEHOLDER" \
    VITE_BASENAME="$VITE_BASENAME" \
    npm run build

FROM nginx:stable-alpine AS runtime

COPY --from=build --chown=nginx:nginx /app/dist /usr/share/nginx/html
COPY --from=build --chown=nginx:nginx /app/dist /usr/share/nginx/html/genomeproperties
COPY docker-entrypoint.sh /docker-entrypoint.sh
COPY nginx.conf /etc/nginx/conf.d/default.conf

RUN chmod +x /docker-entrypoint.sh \
    && chown -R nginx:nginx /usr/share/nginx/html /docker-entrypoint.sh \
    && chown -R nginx:nginx /var/cache/nginx /var/log/nginx /etc/nginx/conf.d \
    && touch /var/run/nginx.pid \
    && chown nginx:nginx /var/run/nginx.pid

USER nginx

EXPOSE 8000

ENTRYPOINT ["/docker-entrypoint.sh"]
